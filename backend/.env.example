# 霜铃后端环境变量占位（复制为 .env 使用；禁止提交真实密钥）
APP_NAME=霜铃 K12 API
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://shuangling:shuangling@localhost:5432/shuangling
# 生产必须替换为高强度随机值；ENVIRONMENT=prod 时使用 dev 占位会被启动校验拒绝
JWT_SECRET=dev-only-change-me-32bytes-secret
JWT_EXPIRE_MINUTES=10080

# AI Provider：mock=本地演示；openai_compatible=真实 LLM（AI_BASE_URL/AI_API_KEY 从 .env 提供，禁止提交）
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_MAX_TOKENS=512
# DeepSeek V4：短文本教学对话建议关闭思考模式，避免输出额度耗尽但没有最终答案。
AI_THINKING_MODE=disabled
AI_BASE_URL=
AI_API_KEY=

# Embedding / Voice
# mock 保持本地无外部依赖；真实 provider 需要同时填写以下三项，并将维度设为模型实际返回值。
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=64

# Worker / background jobs
WORKER_POLL_INTERVAL=1.0
WORKER_MAX_ATTEMPTS=3
SUMMARY_MESSAGE_THRESHOLD=20
KNOWLEDGE_UPLOAD_MAX_BYTES=20971520

# Redis：仅用于分布式锁与可丢失缓存；不可用时应用自动降级。
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_LOCK_TTL_SECONDS=120
REDIS_CACHE_TTL_SECONDS=60
VOICE_PROVIDER=mock
TTS_PROVIDER=mock
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_ASR_MODELS=["fun-asr-realtime","fun-asr-realtime-2026-02-28","fun-asr-realtime-2025-11-07","fun-asr-realtime-2025-09-15"]
ALIYUN_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
SPEECH_SAMPLE_RATE=16000
ASR_MAX_FRAME_BYTES=6400
