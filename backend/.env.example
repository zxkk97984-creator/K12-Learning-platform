# 霜铃后端环境变量占位（复制为 .env 使用；禁止提交真实密钥）
APP_NAME=霜铃 K12 API
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://shuangling:shuangling@localhost:5432/shuangling
# 生产必须替换为高强度随机值；ENVIRONMENT=prod 时使用 dev 占位会被启动校验拒绝
JWT_SECRET=dev-only-change-me-32bytes-secret
JWT_EXPIRE_MINUTES=10080

# AI Provider：mock=本地演示；openai_compatible=真实 LLM（AI_BASE_URL/AI_API_KEY 从 .env 提供，禁止提交）
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_MAX_TOKENS=512
AI_BASE_URL=
AI_API_KEY=

# Embedding / Voice 当前均为 mock（真实服务后续 Phase 接入）
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=64
VOICE_PROVIDER=mock
