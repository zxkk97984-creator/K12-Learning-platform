# 霜铃后端环境变量占位（复制为 .env 使用；禁止提交真实密钥）
APP_NAME=霜铃 K12 API
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://shuangling:shuangling@localhost:5432/shuangling
# 生产必须替换为高强度随机值；ENVIRONMENT=prod 时使用 dev 占位会被启动校验拒绝
JWT_SECRET=dev-only-change-me-32bytes-secret
JWT_EXPIRE_MINUTES=10080

# AI Provider：mock=本地演示；openai_compatible=真实 LLM（AI_BASE_URL/AI_API_KEY 从 .env 提供，禁止提交）
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_MAX_TOKENS=512
# DeepSeek V4：短文本教学对话建议关闭思考模式，避免输出额度耗尽但没有最终答案。
AI_THINKING_MODE=disabled
AI_BASE_URL=
AI_API_KEY=

# Embedding / Voice
# mock 保持本地无外部依赖；真实 provider 需要同时填写以下三项，并将维度设为模型实际返回值。
# 切换真实 provider 后，需对已入库的知识资源重新生成向量：
#   uv run python -m app.scripts.reindex_embeddings   （--dry-run 先预览；--limit N 小批验证）
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=64

# Worker / background jobs
WORKER_POLL_INTERVAL=1.0
WORKER_MAX_ATTEMPTS=3
# running 状态任务超过该秒数视为 Worker 崩溃遗留孤儿，自动回收重排
WORKER_RUNNING_TTL_SECONDS=600
SUMMARY_MESSAGE_THRESHOLD=20
KNOWLEDGE_UPLOAD_MAX_BYTES=20971520

# Redis：仅用于分布式锁与可丢失缓存；不可用时应用自动降级。
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_LOCK_TTL_SECONDS=120
REDIS_CACHE_TTL_SECONDS=60
VOICE_PROVIDER=mock
# mock 仅限本地/测试；真实 TTS 需配置 openai_compatible 或相应 provider。
# 未配置时语音接口返回明确的 TTS_UNAVAILABLE，不再静音假音频。
TTS_PROVIDER=none
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_ASR_MODELS=["fun-asr-realtime","fun-asr-realtime-2026-02-28","fun-asr-realtime-2025-11-07","fun-asr-realtime-2025-09-15"]
ALIYUN_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
SPEECH_SAMPLE_RATE=16000
ASR_MAX_FRAME_BYTES=6400

# ---- Phase 5-A：限流（Redis 可用则分布式，否则进程内降级；均强制）----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=30

# ---- CodeLab：在线编程教学工具 ----
# 默认关闭；开启后需要 Docker 与下面两个沙箱镜像都可用。
# 两个镜像分工不同且不能合并：run 镜像含 matplotlib（无 pytest），judge 镜像含 pytest（无 matplotlib）。
CODELAB_ENABLED=false
CODELAB_RUN_IMAGE=dai-kernel-python:latest
CODELAB_JUDGE_IMAGE=dai-judge-python:latest
CODELAB_RUN_TIMEOUT_SECONDS=10
CODELAB_JUDGE_TIMEOUT_SECONDS=20
CODELAB_MEMORY_LIMIT_MB=256
CODELAB_CPU_LIMIT=1.0
CODELAB_MAX_CODE_BYTES=50000
CODELAB_MAX_OUTPUT_BYTES=65536
CODELAB_MAX_CONCURRENT=2
CODELAB_WORK_DIR=storage/codelab
# 未设置时与 CODELAB_WORK_DIR 相同；API 容器化后必须显式设为宿主机路径
CODELAB_HOST_WORK_DIR=
CODELAB_RATE_LIMIT_PER_MINUTE=20

# 结构化 JSON 调用（CodeLab 代码评分）的超时与重试；streaming 对话仍用 30s
AI_JSON_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
